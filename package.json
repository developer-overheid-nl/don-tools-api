{
  "name": "tools-api-v1",
  "version": "1.0.0",
  "description": "API van het Tools (apis.developer.overheid.nl)",
  "main": "dist/app/index.js",
  "scripts": {
    "init-install": "npm install",
    "dev": "tsx watch --env-file-if-exists=.env app/index.ts",
    "dev-mock": "OPENAPI_MOCK=true npm run dev",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/app/index.js",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate-api.mjs"
  },
  "license": "EUPL-1.2",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@developer-overheid-nl/don-tools": "github:developer-overheid-nl/don-tools#21d4f5bc1c19d5f665c004828045a12430c062e9",
    "@fastify/cors": "11.3.0",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-fastify": "12.1.1",
    "ajv-formats": "3.0.1",
    "croner": "10.0.1",
    "fastify": "5.12.5",
    "js-yaml": "5.4.2",
    "openapi-backend": "5.21.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "fast-uri@>=3.0.0 <4.0.0": "3.1.8",
    "js-yaml@>=4.0.0 <5.0.0": "4.3.2",
    "lodash": "4.18.1",
    "yaml@>=1.0.0 <2.0.0": "1.10.3",
    "@developer-overheid-nl/adr-rulesets": "github:developer-overheid-nl/adr-rulesets#da1327dfcc83ed130b1fe5aaa282b7bfba537aee"
  }
}
