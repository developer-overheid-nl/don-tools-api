{
  "name": "tools-api-v1",
  "version": "1.0.0",
  "description": "API van het Tools (apis.developer.overheid.nl)",
  "main": "dist/app/index.js",
  "scripts": {
    "init-install": "npm install",
    "dev": "tsx watch --env-file-if-exists=.env app/index.ts",
    "dev-mock": "OPENAPI_MOCK=true npm run dev",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/app/index.js",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate-api.mjs"
  },
  "license": "EUPL-1.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@developer-overheid-nl/don-tools": "0.0.3",
    "@fastify/cors": "11.3.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "ajv-formats": "^3.0.1",
    "fastify": "5.12.0",
    "js-yaml": "^5.3.0",
    "openapi-backend": "^5.20.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri@>=3.0.0 <4.0.0": "3.1.5",
    "js-yaml@>=4.0.0 <5.0.0": "4.3.1",
    "lodash": "4.18.1",
    "yaml@>=1.0.0 <2.0.0": "1.10.3"
  }
}
